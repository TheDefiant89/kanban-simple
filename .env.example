# Copy this file to .env.local for local development.
# Get these values from your Supabase project: Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, local dev only: force feature flags on without touching the
# database, e.g. VITE_FEATURE_FLAGS=bulk-edit,calendar. Ignored in production
# builds. See "Feature flags" in README.md.
# VITE_FEATURE_FLAGS=

# Optional: override the Vite base path used for GitHub Pages deployment.
# Defaults to "/kanban-simple/" (matching the repo name). Only needed if
# you rename the repository or deploy elsewhere.
# VITE_BASE_PATH=/kanban-simple/
